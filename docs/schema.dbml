Project open_project {
  database_type: 'PostgreSQL'
  Note: 'Core schema for users, projects, tasks, and task comments.'
}

Table users {
  id uuid [pk]
  email varchar(320) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(160) [not null]
  role varchar(20) [not null, default: 'employee', note: 'admin or employee']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]

  indexes {
    email [unique, name: 'ix_users_email']
  }
}

Table projects {
  id uuid [pk]
  name varchar(160) [not null]
  description text
  owner_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table project_members {
  id uuid [pk]
  project_id uuid [not null]
  user_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    project_id [name: 'ix_project_members_project_id']
    user_id [name: 'ix_project_members_user_id']
    (project_id, user_id) [unique]
  }
}

Table tasks {
  id uuid [pk]
  project_id uuid [not null]
  title varchar(200) [not null]
  description text
  status varchar(20) [not null, default: 'todo', note: 'todo, in_progress, or done']
  due_at timestamptz
  assignee_id uuid
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    project_id [name: 'ix_tasks_project_id']
    assignee_id [name: 'ix_tasks_assignee_id']
  }
}

Table task_comments {
  id uuid [pk]
  task_id uuid [not null]
  author_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null]

  indexes {
    task_id [name: 'ix_task_comments_task_id']
  }
}

Ref: projects.owner_id > users.id [delete: restrict]
Ref: project_members.project_id > projects.id [delete: cascade]
Ref: project_members.user_id > users.id [delete: cascade]
Ref: tasks.project_id > projects.id [delete: cascade]
Ref: tasks.assignee_id > users.id [delete: set null]
Ref: tasks.created_by > users.id [delete: restrict]
Ref: task_comments.task_id > tasks.id [delete: cascade]
Ref: task_comments.author_id > users.id [delete: restrict]