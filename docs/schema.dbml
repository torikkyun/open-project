Project open_project {
  database_type: 'PostgreSQL'
  Note: 'Schema after Alembic revision 0007_password_reset_tokens.'
}

Table users {
  id uuid [pk]
  email varchar(320) [not null]
  password_hash varchar(255) [not null]
  full_name varchar(160) [not null]
  avatar_url varchar(500)
  role varchar(20) [not null, note: 'admin or employee']
  is_active boolean [not null]
  created_at timestamptz [not null]

  indexes {
    email [unique, name: 'ix_users_email']
  }
}

Table projects {
  id uuid [pk]
  project_key varchar(10) [not null]
  next_task_number integer [not null, default: 0]
  name varchar(160) [not null]
  description text
  owner_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    project_key [unique, name: 'uq_projects_project_key']
  }
}

Table project_members {
  id uuid [pk]
  project_id uuid [not null]
  user_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    project_id [name: 'ix_project_members_project_id']
    user_id [name: 'ix_project_members_user_id']
    (project_id, user_id) [unique]
  }
}

Table tasks {
  id uuid [pk]
  project_id uuid [not null]
  parent_task_id uuid
  task_number integer [not null]
  start_at timestamptz
  title varchar(200) [not null]
  description text
  status varchar(20) [not null, note: 'todo, in_progress, or done']
  priority varchar(20) [not null, default: 'none', note: 'none, low, medium, high, or highest']
  position float [not null, default: 0]
  due_at timestamptz
  assignee_id uuid
  created_by uuid [not null]
  reporter_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    project_id [name: 'ix_tasks_project_id']
    parent_task_id [name: 'ix_tasks_parent_task_id']
    assignee_id [name: 'ix_tasks_assignee_id']
    (project_id, task_number) [unique, name: 'uq_tasks_project_task_number']
  }

  checks {
    `status IN ('todo', 'in_progress', 'done')` [name: 'ck_tasks_status']
    `priority IN ('none', 'low', 'medium', 'high', 'highest')` [name: 'ck_tasks_priority']
  }
}

Table task_comments {
  id uuid [pk]
  task_id uuid [not null]
  author_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null]

  indexes {
    task_id [name: 'ix_task_comments_task_id']
  }
}

Table task_attachments {
  id uuid [pk]
  task_id uuid [not null]
  comment_id uuid
  uploader_id uuid [not null]
  original_name varchar(255) [not null]
  content_type varchar(120) [not null]
  size_bytes integer [not null]
  storage_path varchar(500) [not null]
  created_at timestamptz [not null]

  indexes {
    task_id [name: 'ix_task_attachments_task_id']
    comment_id [name: 'ix_task_attachments_comment_id']
  }
}

Table refresh_sessions {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]

  indexes {
    user_id [name: 'ix_refresh_sessions_user_id']
    token_hash [name: 'ix_refresh_sessions_token_hash']
  }
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null]

  indexes {
    user_id [name: 'ix_password_reset_tokens_user_id']
    token_hash [name: 'ix_password_reset_tokens_token_hash']
  }
}

Ref: projects.owner_id > users.id [delete: restrict]
Ref: project_members.project_id > projects.id [delete: cascade]
Ref: project_members.user_id > users.id [delete: cascade]
Ref: tasks.project_id > projects.id [delete: cascade]
Ref: tasks.parent_task_id >? tasks.id [delete: cascade]
Ref: tasks.assignee_id >? users.id [delete: set null]
Ref: tasks.created_by > users.id [delete: restrict]
Ref: tasks.reporter_id > users.id [delete: restrict]
Ref: task_comments.task_id > tasks.id [delete: cascade]
Ref: task_comments.author_id > users.id [delete: restrict]
Ref: task_attachments.task_id > tasks.id [delete: cascade]
Ref: task_attachments.comment_id >? task_comments.id [delete: cascade]
Ref: task_attachments.uploader_id > users.id [delete: restrict]
Ref: refresh_sessions.user_id > users.id [delete: cascade]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
