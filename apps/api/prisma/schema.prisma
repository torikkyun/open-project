generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    admin
    project_manager
    member
    guest
}

enum ProjectRole {
    manager
    member
    guest
}

enum ProjectStatus {
    not_started
    in_progress
    on_hold
    completed
    archived
}

enum TaskStatus {
    todo
    in_progress
    review
    done
    canceled
}

enum Priority {
    low
    medium
    high
    critical
}

enum DependencyType {
    FS
    FF
    SS
    SF
}

enum NotificationType {
    task_assigned
    task_updated
    task_status_changed
    comment_added
    task_review_requested
    task_review_approved
    task_review_rejected
    task_overdue
    project_added
}

enum FieldType {
    text
    number
    dropdown
    date
    checkbox
}

model User {
    id           String    @id @default(uuid()) @db.Uuid
    name         String    @db.VarChar(255)
    email        String    @unique @db.VarChar(255)
    passwordHash String    @map("password_hash") @db.VarChar(255)
    role         UserRole  @default(member)
    departmentId String?   @map("department_id") @db.Uuid
    createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt    DateTime? @map("deleted_at") @db.Timestamp(3)

    department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    createdProjects  Project[]       @relation("ProjectCreator")
    projectMembers   ProjectMember[]
    taskAssignees    TaskAssignee[]
    comments         Comment[]
    attachments      Attachment[]
    notifications    Notification[]
    createdTemplates Template[]      @relation("TemplateCreator")

    @@index([departmentId])
    @@index([role])
    @@index([deletedAt])
    @@index([createdAt])
    @@map("users")
}

model Department {
    id        String    @id @default(uuid()) @db.Uuid
    name      String    @db.VarChar(255)
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt DateTime? @map("deleted_at") @db.Timestamp(3)

    users User[]

    @@index([name])
    @@index([deletedAt])
    @@map("departments")
}

model Project {
    id          String        @id @default(uuid()) @db.Uuid
    name        String        @db.VarChar(255)
    description String?
    startDate   DateTime      @map("start_date") @db.Date
    endDate     DateTime      @map("end_date") @db.Date
    status      ProjectStatus @default(not_started)
    createdById String        @map("created_by") @db.Uuid
    templateId  String?       @map("template_id") @db.Uuid
    createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt   DateTime?     @map("deleted_at") @db.Timestamp(3)

    createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
    template    Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    members     ProjectMember[]
    tasks       Task[]
    milestones  Milestone[]
    attachments Attachment[]

    @@index([status])
    @@index([createdById])
    @@index([templateId])
    @@index([startDate])
    @@index([endDate])
    @@index([deletedAt])
    @@index([createdAt])
    @@map("projects")
}

model ProjectMember {
    id         String      @id @default(uuid()) @db.Uuid
    projectId  String      @map("project_id") @db.Uuid
    userId     String      @map("user_id") @db.Uuid
    role       ProjectRole @default(member)
    canView    Boolean     @default(true) @map("can_view")
    canComment Boolean     @default(false) @map("can_comment")
    canUpload  Boolean     @default(false) @map("can_upload")
    createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt  DateTime?   @map("deleted_at") @db.Timestamp(3)

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([projectId, userId])
    @@index([projectId])
    @@index([userId])
    @@index([deletedAt])
    @@map("project_members")
}

model Task {
    id              String     @id @default(uuid()) @db.Uuid
    projectId       String     @map("project_id") @db.Uuid
    parentTaskId    String?    @map("parent_task_id") @db.Uuid
    title           String     @db.VarChar(255)
    description     String?
    priority        Priority   @default(medium)
    estimatedHours  Decimal?   @map("estimated_hours") @db.Decimal(10, 2)
    actualHours     Decimal?   @map("actual_hours") @db.Decimal(10, 2)
    startDate       DateTime?  @map("start_date") @db.Date
    endDate         DateTime?  @map("end_date") @db.Date
    progressPercent Int        @default(0) @map("progress_percent")
    status          TaskStatus @default(todo)
    isMilestone     Boolean    @default(false) @map("is_milestone")
    createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt       DateTime?  @map("deleted_at") @db.Timestamp(3)

    project                 Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    parentTask              Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    subtasks                Task[]            @relation("TaskHierarchy")
    assignees               TaskAssignee[]
    predecessorDependencies TaskDependency[]  @relation("TaskPredecessor")
    successorDependencies   TaskDependency[]  @relation("TaskSuccessor")
    milestones              Milestone[]
    comments                Comment[]
    attachments             Attachment[]
    customFields            TaskCustomField[]

    @@index([projectId])
    @@index([parentTaskId])
    @@index([status])
    @@index([priority])
    @@index([startDate])
    @@index([endDate])
    @@index([isMilestone])
    @@index([deletedAt])
    @@index([createdAt])
    @@map("tasks")
}

model TaskAssignee {
    id        String    @id @default(uuid()) @db.Uuid
    taskId    String    @map("task_id") @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt DateTime? @map("deleted_at") @db.Timestamp(3)

    task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([taskId, userId])
    @@index([taskId])
    @@index([userId])
    @@index([deletedAt])
    @@map("task_assignees")
}

model TaskDependency {
    id                String         @id @default(uuid()) @db.Uuid
    predecessorTaskId String         @map("predecessor_task_id") @db.Uuid
    successorTaskId   String         @map("successor_task_id") @db.Uuid
    dependencyType    DependencyType @default(FS) @map("dependency_type")
    lagDays           Int            @default(0) @map("lag_days")
    createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt         DateTime?      @map("deleted_at") @db.Timestamp(3)

    predecessorTask Task @relation("TaskPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    successorTask   Task @relation("TaskSuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([predecessorTaskId, successorTaskId])
    @@index([predecessorTaskId])
    @@index([successorTaskId])
    @@index([deletedAt])
    @@map("task_dependencies")
}

model Milestone {
    id          String    @id @default(uuid()) @db.Uuid
    projectId   String    @map("project_id") @db.Uuid
    name        String    @db.VarChar(255)
    description String?
    dueDate     DateTime  @map("due_date") @db.Date
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt   DateTime? @map("deleted_at") @db.Timestamp(3)

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    taskId  String? @map("task_id") @db.Uuid

    @@index([projectId])
    @@index([dueDate])
    @@index([deletedAt])
    @@map("milestones")
}

model Comment {
    id              String    @id @default(uuid()) @db.Uuid
    taskId          String    @map("task_id") @db.Uuid
    userId          String    @map("user_id") @db.Uuid
    parentCommentId String?   @map("parent_comment_id") @db.Uuid
    content         String    @db.Text
    createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt       DateTime? @map("deleted_at") @db.Timestamp(3)

    task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    parent      Comment?     @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    replies     Comment[]    @relation("CommentReplies")
    attachments Attachment[]

    @@index([taskId])
    @@index([userId])
    @@index([parentCommentId])
    @@index([createdAt])
    @@index([deletedAt])
    @@map("comments")
}

model Attachment {
    id        String    @id @default(uuid()) @db.Uuid
    projectId String?   @map("project_id") @db.Uuid
    taskId    String?   @map("task_id") @db.Uuid
    commentId String?   @map("comment_id") @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    fileName  String    @map("file_name") @db.VarChar(255)
    filePath  String    @map("file_path") @db.VarChar(500)
    fileSize  BigInt    @map("file_size") @db.BigInt
    mimeType  String?   @map("mime_type") @db.VarChar(100)
    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt DateTime? @map("deleted_at") @db.Timestamp(3)

    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    user    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@index([projectId])
    @@index([taskId])
    @@index([commentId])
    @@index([userId])
    @@index([createdAt])
    @@index([deletedAt])
    @@map("attachments")
}

model Notification {
    id        String           @id @default(uuid()) @db.Uuid
    userId    String           @map("user_id") @db.Uuid
    type      NotificationType
    content   String           @db.Text
    isRead    Boolean          @default(false) @map("is_read")
    readAt    DateTime?        @map("read_at") @db.Timestamp(3)
    createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt DateTime?        @map("deleted_at") @db.Timestamp(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([userId])
    @@index([isRead])
    @@index([createdAt])
    @@index([deletedAt])
    @@map("notifications")
}

model Template {
    id          String    @id @default(uuid()) @db.Uuid
    name        String    @db.VarChar(255)
    description String?
    createdById String    @map("created_by") @db.Uuid
    createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt   DateTime? @map("deleted_at") @db.Timestamp(3)

    createdBy User           @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
    projects  Project[]
    tasks     TemplateTask[]

    @@index([createdById])
    @@index([name])
    @@index([deletedAt])
    @@map("templates")
}

model TemplateTask {
    id                   String    @id @default(uuid()) @db.Uuid
    templateId           String    @map("template_id") @db.Uuid
    parentTemplateTaskId String?   @map("parent_template_task_id") @db.Uuid
    title                String    @db.VarChar(255)
    description          String?
    estimatedHours       Decimal?  @map("estimated_hours") @db.Decimal(10, 2)
    startOffsetDays      Int       @default(0) @map("start_offset_days")
    durationDays         Int       @default(1) @map("duration_days")
    priority             Priority  @default(medium)
    isMilestone          Boolean   @default(false) @map("is_milestone")
    createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt            DateTime? @map("deleted_at") @db.Timestamp(3)

    template Template       @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    parent   TemplateTask?  @relation("TemplateTaskHierarchy", fields: [parentTemplateTaskId], references: [id], onDelete: SetNull, onUpdate: Cascade)
    subtasks TemplateTask[] @relation("TemplateTaskHierarchy")

    @@index([templateId])
    @@index([parentTemplateTaskId])
    @@index([deletedAt])
    @@map("template_tasks")
}

model CustomField {
    id         String    @id @default(uuid()) @db.Uuid
    name       String    @db.VarChar(255)
    fieldType  FieldType @map("field_type")
    options    String?
    isRequired Boolean   @default(false) @map("is_required")
    createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt  DateTime? @map("deleted_at") @db.Timestamp(3)

    taskValues TaskCustomField[]

    @@index([fieldType])
    @@index([deletedAt])
    @@map("custom_fields")
}

model TaskCustomField {
    id            String    @id @default(uuid()) @db.Uuid
    taskId        String    @map("task_id") @db.Uuid
    customFieldId String    @map("custom_field_id") @db.Uuid
    value         String    @db.Text
    createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
    updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
    deletedAt     DateTime? @map("deleted_at") @db.Timestamp(3)

    task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([taskId, customFieldId])
    @@index([taskId])
    @@index([customFieldId])
    @@index([deletedAt])
    @@map("task_custom_fields")
}
