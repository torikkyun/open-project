generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(50)
  name         String @db.VarChar(120)
  passwordHash String @map("password_hash") @db.VarChar(255)
  avatarUrl    String @map("avatar_url") @db.VarChar(255)

  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  membership          Membership?
  invitationsSent     Invitation[]  @relation("InvitationInviter")
  invitationsReceived Invitation[]  @relation("InvitationInvitee")
  refreshToken        RefreshToken?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model UserRole {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(50)
  code        String @unique @db.VarChar(50)
  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  memberships Membership[]
  invitations Invitation[]

  @@map("user_roles")
}

model InvitationStatus {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(50)
  code        String @unique @db.VarChar(50)
  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  invitations Invitation[]

  @@map("invitation_statuses")
}

model Membership {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  roleId String   @map("role_id") @db.Uuid
  role   UserRole @relation(fields: [roleId], references: [id])

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@map("memberships")
}

model Invitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @db.VarChar(320)
  token      String    @unique @db.Text
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  roleId String   @map("role_id") @db.Uuid
  role   UserRole @relation(fields: [roleId], references: [id])

  statusId String           @map("status_id") @db.Uuid
  status   InvitationStatus @relation(fields: [statusId], references: [id])

  invitedById String? @map("invited_by") @db.Uuid
  invitedBy   User?   @relation("InvitationInviter", fields: [invitedById], references: [id])

  userId String? @db.Uuid
  user   User?   @relation("InvitationInvitee", fields: [userId], references: [id])

  @@index([email, token])
  @@map("invitations")
}
