{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "unicorn/filename-case": ["warn", { "case": "kebabCase" }],
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn"
  },
  "plugins": ["typescript", "unicorn", "import"],
  "ignorePatterns": ["dist", "node_modules", ".output"]
}
