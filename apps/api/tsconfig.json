{
  "extends": "@repo/typescript-config/nest-js",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@/prisma/*": ["./src/generated/prisma/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
